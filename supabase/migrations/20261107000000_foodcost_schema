-- ============================================================
-- FoodCost v3.0 — Supabase schema (FAROUK GRUP)
-- يستبدل: جدول Master (Users / Mapping / Reviews_*) + ملف Google Sheets لكل مطعم
-- شغّل هذا الملف مرة واحدة من: Supabase Dashboard → SQL Editor → New query → Run
-- ============================================================

-- ---------- المستخدمون والاشتراكات (بديل ورقة Users) ----------
create table if not exists public.fc_users (
  email          text primary key check (email = lower(email)),
  password_hash  text not null,                 -- sha256$salt$hash (نفس صيغة Apps Script)
  expiry_date    timestamptz not null,          -- الاشتراك سنوي دائماً
  full_name      text,
  created_at     timestamptz not null default now(),
  frozen         boolean not null default false
);

-- ---------- الجلسات القابلة للإبطال (بديل sess_* في Script Properties) ----------
create table if not exists public.fc_sessions (
  token       text primary key,
  email       text not null references public.fc_users(email) on delete cascade on update cascade,
  expires_at  timestamptz not null,
  created_at  timestamptz not null default now()
);
create index if not exists fc_sessions_email_idx on public.fc_sessions(email);
create index if not exists fc_sessions_exp_idx on public.fc_sessions(expires_at);

-- ---------- معرّفات عمليات الدفع المستخدمة (بديل tx_* في Script Properties) ----------
create table if not exists public.fc_used_transactions (
  tx_id    text primary key,
  email    text not null,
  used_at  timestamptz not null default now()
);

-- ---------- المطعم (بديل ملف المطعم: مين ريسيبي C1 + ورقة اعدادات + البنرات) ----------
create table if not exists public.fc_restaurants (
  email               text primary key check (email = lower(email)),
  name                text not null default 'المطعم',
  waste_percent       double precision not null default 5,
  food_cost_percent   double precision not null default 30,
  currency            text not null default 'ر.س',
  min_margin_percent  double precision not null default 30,
  menu_engineering    jsonb not null default '{}'::jsonb,                                            -- MenuEngineeringData
  digital_menu        jsonb not null default '{"items":[],"categories":["الكل"],"settings":{}}'::jsonb, -- DigitalMenuData
  banner_revision     integer not null default 0,                                                    -- R5 revision
  banner_assets       jsonb,                                                                         -- R5 [{fileId,url}] (null = legacy)
  created_at          timestamptz not null default now(),
  updated_at          timestamptz not null default now()
);

-- ---------- المواد الأولية (بديل ورقة رو ماتيريال) ----------
create table if not exists public.fc_materials (
  restaurant_email  text not null references public.fc_restaurants(email) on delete cascade on update cascade,
  id                text not null,
  name              text not null default '',
  unit              text not null default '',
  price             double precision not null default 0,   -- السعر الفعلي بعد الهدر
  purchase_price    double precision not null default 0,
  purchase_qty      double precision not null default 1,
  waste_percent     double precision not null default 0,
  portion_weight    double precision not null default 0,
  pos               bigserial,
  primary key (restaurant_email, id)
);
create index if not exists fc_materials_pos_idx on public.fc_materials(restaurant_email, pos);

-- ---------- الأطباق (بديل ورقة مين ريسيبي) ----------
create table if not exists public.fc_recipes (
  id                bigserial primary key,
  restaurant_email  text not null references public.fc_restaurants(email) on delete cascade on update cascade,
  name              text not null,
  cost_price        double precision not null default 0,
  labor_percent     double precision not null default 0,
  suggested_price   double precision not null default 0,
  selling_price     double precision not null default 0,
  pos               bigserial,
  unique (restaurant_email, name)
);

-- ---------- مكونات الطبق (بديل ورقة مستقلة لكل طبق) ----------
create table if not exists public.fc_recipe_ingredients (
  id             bigserial primary key,
  recipe_id      bigint not null references public.fc_recipes(id) on delete cascade,
  material_id    text not null,
  material_name  text not null default '',
  quantity       double precision not null default 0,
  pos            integer not null default 0
);
create index if not exists fc_ing_recipe_idx on public.fc_recipe_ingredients(recipe_id, pos);

-- ---------- تاريخ الأسعار ----------
create table if not exists public.fc_price_history (
  id                bigserial primary key,
  restaurant_email  text not null references public.fc_restaurants(email) on delete cascade on update cascade,
  date              timestamptz not null default now(),
  material_id       text,
  material_name     text,
  old_price         double precision not null default 0,
  new_price         double precision not null default 0,
  change_percent    double precision not null default 0
);
create index if not exists fc_ph_idx on public.fc_price_history(restaurant_email, date desc);

-- ---------- المبيعات ----------
create table if not exists public.fc_sales (
  restaurant_email  text not null references public.fc_restaurants(email) on delete cascade on update cascade,
  id                text not null,
  date              timestamptz not null default now(),
  recipe_name       text not null,
  quantity          double precision not null default 0,
  unit_price        double precision not null default 0,
  total             double precision not null default 0,
  pos               bigserial,
  primary key (restaurant_email, id)
);
create index if not exists fc_sales_date_idx on public.fc_sales(restaurant_email, date desc);

-- ---------- طلبات المينيو الإلكتروني ----------
create table if not exists public.fc_menu_orders (
  restaurant_email  text not null references public.fc_restaurants(email) on delete cascade on update cascade,
  id                text not null,
  date              timestamptz not null default now(),
  table_number      text not null default '',
  items             jsonb not null default '[]'::jsonb,
  total             double precision not null default 0,
  notes             text not null default '',
  customer_name     text not null default '',
  customer_phone    text not null default '',
  status            text not null default 'new',
  created_at        text not null default '',
  pos               bigserial,
  primary key (restaurant_email, id)
);
create index if not exists fc_orders_date_idx on public.fc_menu_orders(restaurant_email, date desc);

-- ---------- التقييمات (بديل Reviews_<email> في الجدول الرئيسي) ----------
create table if not exists public.fc_reviews (
  id                bigserial primary key,
  restaurant_email  text not null,
  date              timestamptz not null default now(),
  name              text,
  phone             text,
  visit_date        text,
  people_count      text,
  visit_type        text,
  food              text,
  service           text,
  cleanliness       text,
  price             text,
  overall           text,
  status            text,
  favorite_dishes   text,
  recommendation    text,
  notes             text,
  restaurant_name   text
);
create index if not exists fc_reviews_idx on public.fc_reviews(restaurant_email, id);

-- ---------- لقطات ما قبل الاستعادة (بديل "ملف المطعم السابق لا يُحذف") ----------
create table if not exists public.fc_restore_snapshots (
  id                text primary key,
  restaurant_email  text not null,
  created_at        timestamptz not null default now(),
  snapshot          jsonb not null
);
create index if not exists fc_snap_idx on public.fc_restore_snapshots(restaurant_email, created_at desc);

-- ============================================================
-- إعادة حساب تكلفة كل الأطباق (بديل recalculateAllRecipes)
-- التكلفة = Σ(الكمية × سعر المادة) ، السعر المقترح = التكلفة×(1+الهدر%) ÷ (FoodCost%)
-- ============================================================
create or replace function public.fc_recalc(p_email text)
returns void language sql as $$
  with s as (
    select coalesce(waste_percent, 0) as w,
           case when coalesce(food_cost_percent, 0) > 0 then food_cost_percent else 30 end as f
    from public.fc_restaurants where email = p_email
  ),
  c as (
    select r.id, coalesce(sum(i.quantity * m.price), 0) as total
    from public.fc_recipes r
    left join public.fc_recipe_ingredients i on i.recipe_id = r.id and i.material_id <> '' and i.quantity <> 0
    left join public.fc_materials m on m.restaurant_email = r.restaurant_email and m.id = i.material_id
    where r.restaurant_email = p_email
    group by r.id
  )
  update public.fc_recipes r
     set cost_price = c.total,
         suggested_price = (c.total + c.total * s.w / 100) / (s.f / 100)
    from c, s
   where r.id = c.id;
$$;

-- ============================================================
-- الأمان: كل الجداول مغلقة أمام المفتاح العام (anon) — الوصول فقط عبر Edge Function
-- (service role يتجاوز RLS). لا تضف سياسات عامة.
-- ============================================================
alter table public.fc_users               enable row level security;
alter table public.fc_sessions            enable row level security;
alter table public.fc_used_transactions   enable row level security;
alter table public.fc_restaurants         enable row level security;
alter table public.fc_materials           enable row level security;
alter table public.fc_recipes             enable row level security;
alter table public.fc_recipe_ingredients  enable row level security;
alter table public.fc_price_history       enable row level security;
alter table public.fc_sales               enable row level security;
alter table public.fc_menu_orders         enable row level security;
alter table public.fc_reviews             enable row level security;
alter table public.fc_restore_snapshots   enable row level security;

revoke all on all tables in schema public from anon, authenticated;
revoke execute on function public.fc_recalc(text) from anon, authenticated, public;

